# Copy to .env and adjust. Never commit a real .env.

# PostgreSQL
POSTGRES_USER=shieldnet
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_DB=shieldnet
POSTGRES_PORT=5432

# Backend (Phase 1)
DATABASE_URL=postgresql://shieldnet:change-me-in-env@db:5432/shieldnet
BACKEND_PORT=8000

# WAF
WAF_PORT=8080
# Lifecycle stage: DetectionOnly = learning mode (log only, never blocks)
#                  On            = enforcement (active blocking)
# See docs/DEPLOYMENT_LIFECYCLE.md before changing this.
WAF_RULE_ENGINE=On

# Hybrid scoring thresholds (Phase 4)
RISK_MONITOR_THRESHOLD=40
RISK_BLOCK_THRESHOLD=75

# Auth (JWT console login)
# Long random string in production; Render can generate it (see render.yaml).
JWT_SECRET=change-me-to-a-long-random-string
# Seeded console user, created on first startup when no user exists.
ADMIN_EMAIL=admin@shieldnet.io
ADMIN_PASSWORD=shieldnet
# Refresh cookie: production cross-site hosting needs SECURE=true + SAMESITE=none.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Optional shared key for machine clients on /ingest + /analyze (X-API-Key
# header). Empty = endpoints open (local dev). Set in production.
INGEST_API_KEY=
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=https://shieldnet-web.vercel.app,http://localhost:5173
