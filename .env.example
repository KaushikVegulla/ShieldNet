# Copy to .env and adjust. Never commit a real .env.

# PostgreSQL
POSTGRES_USER=shieldnet
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_DB=shieldnet
POSTGRES_PORT=5432

# Backend (Phase 1)
DATABASE_URL=postgresql://shieldnet:change-me-in-env@db:5432/shieldnet
BACKEND_PORT=8000

# WAF
WAF_PORT=8080
# Lifecycle stage: DetectionOnly = learning mode (log only, never blocks)
#                  On            = enforcement (active blocking)
# See docs/DEPLOYMENT_LIFECYCLE.md before changing this.
WAF_RULE_ENGINE=On

# Hybrid scoring thresholds (Phase 4)
RISK_MONITOR_THRESHOLD=40
RISK_BLOCK_THRESHOLD=75
